# 本檔僅供環境變數設定參考；PowerQuery 不會自動載入此檔。

# 選用：啟用 OpenAI 長尾查詢。API key 不應提交至 Git。
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

# 管理員帳密沒有預設值，且必須同時設定；兩行都未設定時，資料、語料與模型管理功能不會啟用。
# 複製為 .env 後取消註解並換成自己的帳號與長隨機密碼（8～512 字元；含空白時請用雙引號包住），
# 再以 `uv run --env-file .env powerquery --serve` 啟動。
# POWERQUERY_ADMIN_USERNAME=your-admin-name
# POWERQUERY_ADMIN_PASSWORD=replace-with-a-long-random-password

# 管理 session 絕對有效期：300～3600 秒。
POWERQUERY_ADMIN_SESSION_TTL_SECONDS=900

# 允許承載管理介面的 hostname/IP，不含 port；逗號分隔。
POWERQUERY_ADMIN_ALLOWED_HOSTS=127.0.0.1,localhost,::1
